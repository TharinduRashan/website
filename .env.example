# Resend API Key for sending contact form inquiries
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Notification email where contact form submissions should be delivered
CONTACT_TO_EMAIL=info@cloudzyne.com

# Verified sender email on Resend (e.g. onboarding@resend.dev during testing, or inquiries@cloudzyne.com with custom domain)
CONTACT_FROM_EMAIL=onboarding@resend.dev
