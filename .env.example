# Resend API Key for sending contact form inquiries
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Notification email where contact form submissions should be delivered (supports comma-separated list)
CONTACT_TO_EMAIL=info@cloudzyne.com, your-personal@gmail.com

# Verified sender email on Resend from your verified domain
CONTACT_FROM_EMAIL=Cloudzyne <info@cloudzyne.com>
